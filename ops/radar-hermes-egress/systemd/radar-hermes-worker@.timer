[Unit]
Description=Radar/Hermes worker timer for %i
Documentation=https://github.com/Derekko-web/devchinesearizona-backup/tree/main/ops/radar-hermes-egress

[Timer]
# Fallback cadence. The install script writes city-specific weekly overrides.
OnCalendar=Mon *-*-* 00:17:00
RandomizedDelaySec=5m
Persistent=true
Unit=radar-hermes-worker@%i.service

[Install]
WantedBy=timers.target
