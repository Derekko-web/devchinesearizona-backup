# Optional nftables policy for the dedicated radar/Hermes worker identity.
# Review README.md before applying. Replace the worker identity only through
# owner-approved host configuration, not in this repository.

table inet radar_hermes_egress {
  define radar_worker_uid = "radar-hermes"

  set blocked_ipv4 {
    type ipv4_addr
    flags interval
    auto-merge
    elements = {
      0.0.0.0/8,
      10.0.0.0/8,
      100.64.0.0/10,
      127.0.0.0/8,
      169.254.0.0/16,
      172.16.0.0/12,
      192.0.0.0/24,
      192.0.2.0/24,
      192.88.99.0/24,
      192.168.0.0/16,
      198.18.0.0/15,
      198.51.100.0/24,
      203.0.113.0/24,
      224.0.0.0/4,
      240.0.0.0/4
    }
  }

  set blocked_ipv6 {
    type ipv6_addr
    flags interval
    auto-merge
    elements = {
      ::/128,
      ::1/128,
      ::ffff:0:0/96,
      64:ff9b::/96,
      64:ff9b:1::/48,
      100::/64,
      2001::/32,
      2001:2::/48,
      2001:10::/28,
      2001:20::/28,
      2001:db8::/32,
      2002::/16,
      3fff::/20,
      fc00::/7,
      fe80::/10,
      ff00::/8
    }
  }

  chain output {
    type filter hook output priority filter; policy accept;

    meta skuid $radar_worker_uid ip daddr @blocked_ipv4 reject with icmpx admin-prohibited
    meta skuid $radar_worker_uid ip6 daddr @blocked_ipv6 reject with icmpx admin-prohibited

    meta skuid $radar_worker_uid udp dport 53 accept
    meta skuid $radar_worker_uid tcp dport { 53, 80, 443 } accept
    meta skuid $radar_worker_uid reject with icmpx admin-prohibited
  }
}

