{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "convex:dev": "convex dev --local",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "security:audit": "npm audit --audit-level=moderate",
    "verify": "npm run lint -- --max-warnings=0 && npm run test:coverage && npm run build",
    "smoke:dev": "node scripts/smoke-dev.mjs",
    "loop:collect": "node ../../ops/closed-loop/collect-dev-signals.mjs",
    "atlas:sync": "PYTHONPATH=.python-packages python3 -m scripts.atlas_obscura_ingest.cli sync",
    "atlas:publish": "PYTHONPATH=.python-packages python3 -m scripts.atlas_obscura_ingest.cli publish",
    "atlas:test": "PYTHONPATH=.python-packages python3 -m unittest scripts.tests.test_atlas_obscura_ingest",
    "scrape:discover": "PYTHONPATH=.python-packages python3 -m scripts.directory_scrape.cli discover",
    "scrape:enrich": "PYTHONPATH=.python-packages python3 -m scripts.directory_scrape.cli enrich",
    "scrape:dedupe": "PYTHONPATH=.python-packages python3 -m scripts.directory_scrape.cli dedupe_score",
    "scrape:site-fixtures": "PYTHONPATH=.python-packages python3 -m scripts.directory_scrape.cli export_site_fixtures",
    "scrape:run": "PYTHONPATH=.python-packages python3 -m scripts.directory_scrape.cli run",
    "scrape:promote-directory": "PYTHONPATH=.python-packages python3 scripts/plaza_directory_site_export.py",
    "city-directory:discover": "PYTHONPATH=.python-packages python3 -m scripts.city_directory_import.cli discover",
    "city-directory:run": "PYTHONPATH=.python-packages python3 -m scripts.city_directory_import.cli run",
    "city-directory:export-approved": "PYTHONPATH=.python-packages python3 -m scripts.city_directory_import.cli export-approved",
    "city-directory:promote-approved": "PYTHONPATH=.python-packages python3 -m scripts.city_directory_import.cli promote-approved",
    "city-directory:test": "PYTHONPATH=.python-packages python3 -m unittest scripts.tests.test_city_directory_import",
    "scrape:discover-arizona": "set -a && [ -f ./.env.local ] && . ./.env.local; set +a; node scripts/discover_arizona_tiktok/collector.cjs run",
    "scrape:arizona-radar": "set -a && [ -f ./.env.local ] && . ./.env.local; set +a; node scripts/arizona_radar/run.cjs run",
    "scrape:los-angeles-radar": "set -a && [ -f ./.env.local ] && . ./.env.local; set +a; node scripts/arizona_radar/run.cjs run --site=los-angeles",
    "scrape:austin-radar": "set -a && [ -f ./.env.local ] && . ./.env.local; set +a; node scripts/austin_radar/run.cjs run",
    "scrape:arizona-radar:backfill": "set -a && [ -f ./.env.local ] && . ./.env.local; set +a; node scripts/arizona_radar/backfill_to_supabase.cjs",
    "scrape:sf-bay-radar": "set -a && [ -f ./.env.local ] && . ./.env.local; set +a; node scripts/sf_bay_radar/run.cjs run",
    "scrape:test": "PYTHONPATH=.python-packages python3 -m unittest discover -s scripts/tests -p 'test_*.py'",
    "scrape:articles:sunbird": "PYTHONPATH=.python-packages python3 -m scripts.article_ingest.cli run",
    "scrape:signal-desk": "PYTHONPATH=.python-packages python3 -m scripts.signal_desk.cli run",
    "plaza:site-fixtures": "python3 scripts/plaza_directory_site_export.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "cheerio": "^1.2.0",
    "convex": "^1.40.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "^22.3.2",
    "undici": "^7.27.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "convex": {
      "ws": "8.20.1"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.6"
    },
    "next": {
      "postcss": "8.5.10"
    }
  }
}
